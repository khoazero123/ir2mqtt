    "log_level": "list(DEBUG|INFO|WARNING|ERROR)?",
    "kookong_brands": "str?",
    "kookong_max_remotes": "int?",
    "kookong_max_remotes_per_brand": "int?",
    "kookong_max_keys_per_remote": "int?"
